# Injected by the Vercel Neon Marketplace integration. Pull locally with:
#   npx vercel@latest env pull .env.local
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Vercel Cron sends Authorization: Bearer <CRON_SECRET> to POST /api/tick.
# The same secret HMACs the cabinet session cookie (foyer_session).
CRON_SECRET=

# WalletConnect Cloud project id for RainbowKit (injected wallets work without it).
# https://cloud.reown.com
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# GenLayer Studio-dev (chain id 61997). Each house has its own wallet;
# that key signs deploy/judge and pays fees. Optional smoke key for
# `npm run court:deploy` only.
# GENLAYER_PRIVATE_KEY=
# studioDevnet | studionetdev | studionet | testnetBradbury | testnetAsimov
GENLAYER_CHAIN=studioDevnet
# A judge write needs a leader plus validators: about a minute on studio-dev.
GENLAYER_TX_WAIT_INTERVAL_MS=5000
GENLAYER_TX_WAIT_RETRIES=24
# Optional cap for the on-chain wait (ms). After this the case escalates.
# GENLAYER_BUDGET_MS=100000

# Studio chains hand out test GEN over RPC, so a fresh house can pay court
# fees. Set to `off` to require a real deposit instead.
# GENLAYER_FAUCET=off

# Frozen Replay case A shows this hash when a live run was recorded.
# NEXT_PUBLIC_REPLAY_TX=
