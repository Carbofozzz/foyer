# Injected by the Vercel Neon Marketplace integration. Pull locally with:
#   npx vercel@latest env pull .env.local
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# How often production cron should hit GET /api/tick, in seconds.
# Hobby: once a day (`0 0 * * *` in vercel.json). Health marks a tick
# stale after this interval plus a short grace. Override only if the
# Vercel schedule changes (Pro: `* * * * *` and 60).
# CRON_INTERVAL_SEC=86400

# Vercel Cron sends Authorization: Bearer <CRON_SECRET> to POST /api/tick.
# The same secret lists waitlist emails: GET /api/waitlist.
# Keep it on Vercel, never in git.
CRON_SECRET=

# Optional. Seals house wallet keys and agent keys. Falls back to CRON_SECRET.
# Rotate only together with a re-seal of existing rows.
# FOYER_SEAL_SECRET=

# Clerk cabinet login (email + Google). Dashboard → API keys.
# Unset = landing shows "sign-in not configured" and /cabinet redirects home.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Server-side Clerk key. Never expose it to the browser.
CLERK_SECRET_KEY=

# GenLayer Studio-dev (chain id 61997), genlayer-js 2.0.0-rc.1.
# Court/deploy use the SDK `studioDevnet` preset (canonical RPC studio-dev).
# Transaction Kit is not used: the house wallet signs IC writes on the server.
# Optional alias: GENLAYER_CHAIN=studio-next → https://studio-next.genlayer.com/api
# (same chain id; v2-dev boilerplate default). Override RPC without changing chain:
# GENLAYER_RPC_URL=https://studio-next.genlayer.com/api
# NEXT_PUBLIC_GENLAYER_RPC_URL=https://studio-next.genlayer.com/api
# GENLAYER_PRIVATE_KEY=
# studioDevnet | studionetdev | studio-next | studionet | testnetBradbury | testnetAsimov
GENLAYER_CHAIN=studioDevnet
# Deploy / transfer still poll. A judge write is saved on the case and
# polled across ticks until GenLayer finalizes (up to ~30 minutes).
GENLAYER_TX_WAIT_INTERVAL_MS=5000
GENLAYER_TX_WAIT_RETRIES=24
# Optional cap for deploy/transfer waits (ms). Court no longer uses this.
# GENLAYER_BUDGET_MS=100000
# After this many finalized-with-error judge txs, escalate to the principal.
# COURT_TX_ERROR_LIMIT=3

# Platform court wallet (B2). One key deploys every house IC and pays judge.
# Raw 0x private key, or sealed with FOYER_SEAL_SECRET. Required for courts.
# GENLAYER_PLATFORM_KEY=0x…
# Default thresholds until ops saves overrides in /cabinet/admin (DB wins after save).
# Decimal GEN or integer wei. Alert must be ≥ floor.
# GENLAYER_PLATFORM_ALERT_WEI=1
# COURT_FLOOR_WEI=0.3

# Studio chains hand out test GEN over RPC to the platform wallet.
# Set to `off` to require a manual top-up instead.
# GENLAYER_FAUCET=off

# Frozen Replay case A shows this hash when a live run was recorded.
# NEXT_PUBLIC_REPLAY_TX=

# Origin for `npm run demo` / `npm run http:client`. Local default is :3001.
# FOYER_URL=https://foyerapp.dev

# Public origin for wake inbox_url when cron has no request host (defaults to
# VERCEL_PROJECT_PRODUCTION_URL, then https://foyerapp.dev).
# FOYER_PUBLIC_URL=https://foyerapp.dev

# Comma-separated emails promoted to platform_role=owner on login (verified email only).
# They see the ops desk at /:locale/cabinet/admin; everyone else gets 404.
# Remove an email (and downgrade the users row) to demote.
FOYER_ADMIN_EMAILS=

# Court credit gate (BILLING). Explicit on|off; else on in production, off locally.
# FOYER_BILLING_GATE=on
# Optional plan defaults (seeded into billing_plans; ops can edit rows later).
# FOYER_FREE_COURTS=3
# FOYER_PRO_COURTS=20
# Prices in cents. Unset or 0 = not on sale (pricing page says "by code").
# FOYER_PRO_PRICE_CENTS=0
# FOYER_PACK5_PRICE_CENTS=0
# FOYER_PACK20_PRICE_CENTS=0
# GEN crypto checkout (B4). Wei integer or decimal GEN. 0 = not sold for GEN.
# Needs GENLAYER_PLATFORM_KEY (payee). FOYER_CRYPTO=off forces off; on forces on when offers exist.
# FOYER_CRYPTO=on
# FOYER_PRO_PRICE_WEI=1
# FOYER_PACK5_PRICE_WEI=0.5
# FOYER_PACK20_PRICE_WEI=2
# FOYER_PRO_DURATION_DAYS=30


# Resend for confirm + escalate mail (N1). Off when unset: login still works;
# non-production logs the letter instead of sending.
# RESEND_API_KEY=
# RESEND_FROM=Foyer <notify@foyerapp.dev>

# Telegram bot (N2). Username without @. Webhook secret is sent as
# X-Telegram-Bot-Api-Secret-Token. Register once:
#   curl -X POST "$FOYER_URL/api/telegram" -H "authorization: Bearer $CRON_SECRET" \
#     -H "content-type: application/json" -d '{"setup":true}'
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=foyer_bot
# TELEGRAM_WEBHOOK_SECRET=
